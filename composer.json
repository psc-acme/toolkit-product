{
    "name": "psc-acme/toolkit-product",
    "description": "Package toolkit-product for psc-acme organization",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Philipp Scheit",
            "email": "p.scheit@packagist.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "PscAcme\\ToolkitProduct\\": "src/"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/finder": "^7.0",
        "symfony/validator": "^7.0",
        "symfony/filesystem": "^7.0"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^7.0"
    },
    "minimum-stability": "stable",
    "config": {
        "secure-http": false
    },
    "repositories": {
        "private-packagist": {
            "type": "composer",
            "url": "http://repo.packagist.com.lo/psc-acme/"
        },
        "packagist.org": false
    }
}